# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA commite o ".env" de verdade — ele já está no .gitignore.

# String de conexão do PostgreSQL.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vidaplus"

# Porta em que a API vai escutar.
PORT=3333

# Chave usada para assinar os tokens JWT de autenticação.
# Gere uma forte com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="troque-este-valor-por-uma-chave-aleatoria-longa"
JWT_EXPIRES_IN="7d"

# Origem permitida para requisições do frontend (CORS).
CORS_ORIGIN="http://localhost:5173"
